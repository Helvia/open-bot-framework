            </ResponseAssertion>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="A4 generate: Bearer site.wrongsecret -&gt; 401">
            <stringProp name="HTTPSampler.path">/v3/directline/tokens/generate</stringProp>
